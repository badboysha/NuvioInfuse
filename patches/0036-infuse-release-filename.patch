+
+/**
+ * Fork: the name Infuse shows and matches on. A real release file name
+ * (e.g. "Inception.2010.2160p.BluRay.REMUX-FGT.mkv") lets Infuse's subtitle search find subtitles
+ * timed for that exact release. Falls back to the friendly title when the name is missing, looks
+ * like junk, or (for episodes) does not carry this episode's SxxEyy tag, so a season pack's
+ * wrong file name never mislabels the episode.
+ */
+internal fun ExternalPlayerPlaybackRequest.infuseFilename(): String {
+    val fallback = buildPlayerTitle(includeEpisodeTitle = true)
+    val raw = sourceFilename?.substringAfterLast('/')?.substringAfterLast('\\')?.trim().orEmpty()
+    if (raw.length < 8 || '.' !in raw) return fallback
+    val season = season
+    val episode = episode
+    if (season != null && episode != null) {
+        val tag = Regex("(?i)S0*$season[ ._-]?E0*$episode(\\D|$)")
+        if (!tag.containsMatchIn(raw)) return fallback
+    }
+    return raw
+}
