+package com.nuvio.app.features.library
+
+import com.nuvio.app.features.details.MetaDetailsRepository
+import com.nuvio.app.features.notifications.EpisodeReleaseNotificationsClock
+import com.nuvio.app.features.watched.WatchedItem
+import com.nuvio.app.features.watched.WatchedRepository
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+
+/** Fork: one title on one diary day; episodes of a series watched that day are merged. */
+data class DiaryEntry(
+    val id: String,
+    val type: String,
+    val name: String,
+    val poster: String?,
+    /** "S2E5"-style labels, oldest first; empty for a movie or a whole-series mark. */
+    val episodes: List<String>,
+)
+
+data class DiaryDay(
+    /** yyyy-MM-dd, device-local. */
+    val date: String,
+    val entries: List<DiaryEntry>,
+)
+
+data class Achievement(
+    val title: String,
+    val detail: String,
+    /** 0 = not earned yet, 1..3 = bronze/silver/gold. */
+    val tier: Int,
+    /** Progress toward the next tier, 0..1 (1 when the top tier is earned). */
+    val progress: Float,
+)
+
+data class WatchStatsSummary(
+    val movies: Int,
+    val episodes: Int,
+    val showsStarted: Int,
+    val showsFinished: Int,
+    /** Rough total: 110 min per movie, 45 per episode. */
+    val estimatedHours: Int,
+    val thisMonth: Int,
+    val thisYear: Int,
+    val longestStreakDays: Int,
+    /** Top genres from your library, most common first. */
+    val topGenres: List<String>,
+    val movieShare: Int,
+    val days: List<DiaryDay>,
+    val achievements: List<Achievement>,
+)
+
+data class CalendarEntry(
+    val id: String,
+    val type: String,
+    val name: String,
+    val poster: String?,
+    /** yyyy-MM-dd */
+    val date: String,
+    /** "S2E5 · Title", or "Movie release". */
+    val label: String,
+)
+
+/**
+ * Fork: Stats & Diary (from NuvioPro) and the release calendar (from Nuvio Enhanced / NuvioPro),
+ * computed from data Nuvio already keeps on the device: watched history, the library, and addon
+ * metadata. Nothing is sent anywhere.
+ */
+object ForkInsights {
+    private fun localDate(epochMs: Long): String = EpisodeReleaseNotificationsClock.isoDateFromEpochMs(epochMs)
+
+    fun stats(nowEpochMs: Long): WatchStatsSummary {
+        val items = WatchedRepository.uiState.value.items
+        val finished = WatchedRepository.fullyWatchedSeriesKeys.value.size
+        val episodes = items.filter { it.season != null && it.episode != null }
+        val movies = items.filter { it.type == "movie" && it.season == null }
+        val showIds = items.filter { it.type != "movie" }.map { it.id }.toSet()
+        val today = localDate(nowEpochMs)
+
+        val dated = items.map { it to localDate(it.markedAtEpochMs) }
+        val thisMonth = dated.count { it.second.take(7) == today.take(7) }
+        val thisYear = dated.count { it.second.take(4) == today.take(4) }
+
+        val days = dated.groupBy({ it.second }, { it.first })
+            .entries
+            .sortedByDescending { it.key }
+            .map { (date, list) -> DiaryDay(date, merge(list)) }
+
+        val streak = longestStreak(days.map { it.date }.sorted())
+        val hours = (movies.size * 110 + episodes.size * 45) / 60
+
+        val library = LibraryRepository.uiState.value.items
+        val genreCounts = library.flatMap { it.genres }.filter { it.isNotBlank() }
+            .groupingBy { it.trim() }.eachCount()
+        val topGenres = genreCounts.entries.sortedByDescending { it.value }.take(5).map { it.key }
+        val total = movies.size + episodes.size
+        val movieShare = if (total == 0) 0 else movies.size * 100 / total
+
+        return WatchStatsSummary(
+            movies = movies.size,
+            episodes = episodes.size,
+            showsStarted = showIds.size,
+            showsFinished = finished,
+            estimatedHours = hours,
+            thisMonth = thisMonth,
+            thisYear = thisYear,
+            longestStreakDays = streak,
+            topGenres = topGenres,
+            movieShare = movieShare,
+            days = days,
+            achievements = achievements(movies.size, episodes.size, finished, streak, hours),
+        )
+    }
+
+    private fun merge(list: List<WatchedItem>): List<DiaryEntry> =
+        list.sortedByDescending { it.markedAtEpochMs }
+            .groupBy { "${it.type}:${it.id}" }
+            .values
+            .map { group ->
+                val first = group.first()
+                DiaryEntry(
+                    id = first.id,
+                    type = first.type,
+                    name = first.name,
+                    poster = group.firstNotNullOfOrNull { it.poster },
+                    episodes = group.filter { it.season != null && it.episode != null }
+                        .sortedWith(compareBy({ it.season }, { it.episode }))
+                        .map { "S${it.season}E${it.episode}" },
+                )
+            }
+
+    private fun longestStreak(sortedDates: List<String>): Int {
+        var best = 0
+        var run = 0
+        var previous: Long? = null
+        for (date in sortedDates) {
+            val day = dayNumber(date) ?: continue
+            run = if (previous != null && day == previous + 1) run + 1 else 1
+            if (run > best) best = run
+            previous = day
+        }
+        return best
+    }
+
+    /** Days since 1970-01-01 for a yyyy-MM-dd date (proleptic Gregorian). */
+    private fun dayNumber(date: String): Long? {
+        val y = date.take(4).toLongOrNull() ?: return null
+        val m = date.substring(5, 7).toLongOrNull() ?: return null
+        val d = date.substring(8, 10).toLongOrNull() ?: return null
+        val yy = if (m <= 2) y - 1 else y
+        val era = (if (yy >= 0) yy else yy - 399) / 400
+        val yoe = yy - era * 400
+        val doy = (153 * (if (m > 2) m - 3 else m + 9) + 2) / 5 + d - 1
+        val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
+        return era * 146097 + doe - 719468
+    }
+
+    private fun tiered(title: String, unit: String, value: Int, tiers: List<Int>): Achievement {
+        val earned = tiers.count { value >= it }
+        val next = tiers.getOrNull(earned)
+        val previous = if (earned == 0) 0 else tiers[earned - 1]
+        val progress = if (next == null) 1f else (value - previous).toFloat() / (next - previous)
+        val detail = if (next == null) "$value $unit" else "$value / $next $unit"
+        return Achievement(title, detail, earned, progress.coerceIn(0f, 1f))
+    }
+
+    private fun achievements(movies: Int, episodes: Int, finished: Int, streak: Int, hours: Int) = listOf(
+        tiered("Film Buff", "movies", movies, listOf(10, 50, 200)),
+        tiered("Binge Watcher", "episodes", episodes, listOf(50, 250, 1000)),
+        tiered("Completionist", "shows finished", finished, listOf(1, 10, 50)),
+        tiered("On a Roll", "days in a row", streak, listOf(3, 7, 30)),
+        tiered("Couch Time", "hours", hours, listOf(24, 250, 1000)),
+    )
+
+    private val calendarMutex = Mutex()
+    private var calendarCache: Pair<String, List<CalendarEntry>>? = null
+
+    /**
+     * Episodes of the series in your library (plus library movies with a known future release date)
+     * from 7 days ago to 60 days ahead, soonest first. Metadata comes from your addons; cached per day.
+     */
+    suspend fun calendar(nowEpochMs: Long, force: Boolean = false): List<CalendarEntry> {
+        val today = localDate(nowEpochMs)
+        calendarMutex.withLock { calendarCache?.let { if (!force && it.first == today) return it.second } }
+        val from = localDate(nowEpochMs - 7L * 86_400_000L)
+        val until = localDate(nowEpochMs + 60L * 86_400_000L)
+        val library = LibraryRepository.uiState.value.items
+        val series = library.filter { it.type.equals("series", true) || it.type.equals("tv", true) }.take(80)
+        val gate = Semaphore(4)
+        val episodeEntries = coroutineScope {
+            series.map { item ->
+                async {
+                    gate.withPermit {
+                        val meta = runCatching { MetaDetailsRepository.fetch(item.type, item.id) }.getOrNull()
+                            ?: return@withPermit emptyList()
+                        meta.videos.mapNotNull { video ->
+                            val date = video.released?.take(10)?.takeIf { it.length == 10 } ?: return@mapNotNull null
+                            if (date < from || date > until) return@mapNotNull null
+                            val season = video.season ?: return@mapNotNull null
+                            val episode = video.episode ?: return@mapNotNull null
+                            if (season == 0) return@mapNotNull null
+                            val title = video.title.takeIf { it.isNotBlank() && !it.startsWith("Episode", true) }
+                            CalendarEntry(
+                                id = item.id,
+                                type = item.type,
+                                name = meta.name.ifBlank { item.name },
+                                poster = meta.poster ?: item.poster,
+                                date = date,
+                                label = listOfNotNull("S${season}E$episode", title).joinToString(" · "),
+                            )
+                        }
+                    }
+                }
+            }.awaitAll().flatten()
+        }
+        val movieEntries = library.filter { it.type == "movie" }.mapNotNull { item ->
+            val date = item.releaseInfo?.trim()?.take(10)?.takeIf { it.length == 10 && it[4] == '-' } ?: return@mapNotNull null
+            if (date < from || date > until) return@mapNotNull null
+            CalendarEntry(item.id, item.type, item.name, item.poster, date, "Movie release")
+        }
+        val result = (episodeEntries + movieEntries)
+            .distinctBy { "${it.id}|${it.date}|${it.label}" }
+            .sortedWith(compareBy({ it.date }, { it.name }))
+        calendarMutex.withLock { calendarCache = today to result }
+        return result
+    }
+
+    @Throws(Throwable::class)
+    suspend fun calendarChecked(nowEpochMs: Long, force: Boolean): List<CalendarEntry> = calendar(nowEpochMs, force)
+
+    fun todayLocal(nowEpochMs: Long): String = localDate(nowEpochMs)
+}
