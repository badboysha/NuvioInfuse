+import coil3.compose.AsyncImage
+import com.nuvio.app.features.watchprogress.WatchProgressClock
+
+/** Fork: which page of the Stats / Diary / Calendar screen is open. */
+enum class ForkInsightsPage(val label: String) { Stats("Stats"), Diary("Diary"), Calendar("Calendar") }
+
+/**
+ * Fork: Stats, Diary (from NuvioPro) and the release Calendar (from Nuvio Enhanced / NuvioPro),
+ * opened from the Library header. Data comes from [ForkInsights].
+ */
+@Composable
+fun ForkInsightsScreen(initialPage: ForkInsightsPage, onDismiss: () -> Unit) {
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false),
+    ) {
+        var page by remember { mutableStateOf(initialPage) }
+        val summary = remember { ForkInsights.stats(WatchProgressClock.nowEpochMs()) }
+        var calendar by remember { mutableStateOf<List<CalendarEntry>?>(null) }
+        LaunchedEffect(page) {
+            if (page == ForkInsightsPage.Calendar && calendar == null) {
+                calendar = runCatching { ForkInsights.calendar(WatchProgressClock.nowEpochMs()) }.getOrDefault(emptyList())
+            }
+        }
+        val today = remember { ForkInsights.todayLocal(WatchProgressClock.nowEpochMs()) }
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(MaterialTheme.colorScheme.background)
+                .statusBarsPadding(),
+        ) {
+            Row(
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                ForkInsightsPage.entries.forEach { p ->
+                    FilterChip(selected = page == p, onClick = { page = p }, label = { Text(p.label) })
+                }
+                Spacer(Modifier.weight(1f))
+                IconButton(onClick = onDismiss) {
+                    Icon(Icons.Rounded.Close, contentDescription = "Close")
+                }
+            }
+            when (page) {
+                ForkInsightsPage.Stats -> StatsPage(summary)
+                ForkInsightsPage.Diary -> DiaryPage(summary)
+                ForkInsightsPage.Calendar -> CalendarPage(calendar, today)
+            }
+        }
+    }
+}
+
+@Composable
+private fun StatsPage(s: WatchStatsSummary) {
+    val tiles = listOf(
+        "${s.estimatedHours}" to "hours watched (est.)",
+        "${s.movies}" to "movies",
+        "${s.episodes}" to "episodes",
+        "${s.showsFinished} / ${s.showsStarted}" to "shows finished",
+        "${s.thisMonth}" to "this month",
+        "${s.thisYear}" to "this year",
+        "${s.longestStreakDays}" to "best streak (days)",
+        "${s.movieShare}% / ${100 - s.movieShare}%" to "movies / episodes",
+    )
+    LazyColumn(contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        items(tiles.chunked(2)) { pair ->
+            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                pair.forEach { (value, label) ->
+                    Column(
+                        modifier = Modifier
+                            .weight(1f)
+                            .clip(RoundedCornerShape(16.dp))
+                            .background(MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f))
+                            .padding(14.dp),
+                    ) {
+                        Text(value, fontSize = 28.sp, fontWeight = FontWeight.Bold, maxLines = 1)
+                        Text(label, style = MaterialTheme.typography.labelMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    }
+                }
+                if (pair.size == 1) Spacer(Modifier.weight(1f))
+            }
+        }
+        if (s.topGenres.isNotEmpty()) {
+            item { SectionTitle("Taste") }
+            item { Text(s.topGenres.joinToString("  ·  "), style = MaterialTheme.typography.bodyLarge) }
+        }
+        item { SectionTitle("Achievements") }
+        items(s.achievements) { a -> AchievementRow(a) }
+    }
+}
+
+@Composable
+private fun AchievementRow(a: Achievement) {
+    val colors = listOf(Color.Gray, Color(0xFFCD7F32), Color(0xFFC0C0C0), Color(0xFFFFD700))
+    val color = colors[a.tier.coerceIn(0, 3)]
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(14.dp)) {
+        Box(contentAlignment = Alignment.Center) {
+            CircularProgressIndicator(
+                progress = { a.progress },
+                modifier = Modifier.size(48.dp),
+                color = color,
+                trackColor = Color.White.copy(alpha = 0.12f),
+                strokeWidth = 4.dp,
+            )
+            Icon(Icons.Rounded.EmojiEvents, contentDescription = null, tint = color, modifier = Modifier.size(24.dp))
+        }
+        Column {
+            Text(a.title, style = MaterialTheme.typography.titleSmall)
+            Text(a.detail, style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
+
+@Composable
+private fun DiaryPage(s: WatchStatsSummary) {
+    if (s.days.isEmpty()) {
+        EmptyText("Nothing watched yet. Finished titles show up here, day by day.")
+        return
+    }
+    LazyColumn(contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        s.days.forEachIndexed { index, day ->
+            if (index == 0 || s.days[index - 1].date.take(7) != day.date.take(7)) {
+                item(key = "m_${day.date}") { SectionTitle(monthTitle(day.date)) }
+            }
+            item(key = "d_${day.date}") {
+                Text(dayTitle(day.date), style = MaterialTheme.typography.labelLarge,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant)
+            }
+            day.entries.forEachIndexed { i, entry ->
+                item(key = "e_${day.date}_$i") {
+                    EntryRow(
+                        poster = entry.poster,
+                        title = entry.name,
+                        detail = entry.episodes.joinToString(", ").ifEmpty {
+                            if (entry.type == "movie") "Movie" else "Series"
+                        },
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun CalendarPage(calendar: List<CalendarEntry>?, today: String) {
+    if (calendar == null) {
+        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+        return
+    }
+    if (calendar.isEmpty()) {
+        EmptyText("No episodes in the next 60 days for the shows in your Library.")
+        return
+    }
+    LazyColumn(contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        calendar.forEachIndexed { index, entry ->
+            if (index == 0 || calendar[index - 1].date != entry.date) {
+                item(key = "h_${entry.date}") {
+                    SectionTitle(if (entry.date == today) "Today" else dayTitle(entry.date))
+                }
+            }
+            item(key = "c_$index") {
+                Box(Modifier.background(Color.Transparent)) {
+                    EntryRow(entry.poster, entry.name, entry.label, dimmed = entry.date < today)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun EntryRow(poster: String?, title: String, detail: String, dimmed: Boolean = false) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+        modifier = Modifier.fillMaxWidth().then(if (dimmed) Modifier.background(Color.Transparent) else Modifier),
+    ) {
+        AsyncImage(
+            model = poster,
+            contentDescription = null,
+            contentScale = ContentScale.Crop,
+            modifier = Modifier
+                .width(46.dp)
+                .height(69.dp)
+                .clip(RoundedCornerShape(8.dp))
+                .background(Color.White.copy(alpha = 0.08f)),
+            alpha = if (dimmed) 0.5f else 1f,
+        )
+        Column(Modifier.weight(1f)) {
+            Text(title, style = MaterialTheme.typography.titleSmall, maxLines = 1, overflow = TextOverflow.Ellipsis,
+                color = MaterialTheme.colorScheme.onBackground.copy(alpha = if (dimmed) 0.5f else 1f))
+            Text(detail, style = MaterialTheme.typography.labelMedium, maxLines = 2, overflow = TextOverflow.Ellipsis,
+                color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(text, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold,
+        modifier = Modifier.padding(top = 8.dp))
+}
+
+@Composable
+private fun EmptyText(text: String) {
+    Box(Modifier.fillMaxSize().padding(24.dp), contentAlignment = Alignment.Center) {
+        Text(text, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+private val MonthNames = listOf("January", "February", "March", "April", "May", "June", "July",
+    "August", "September", "October", "November", "December")
+
+private fun monthTitle(iso: String): String {
+    val m = iso.substring(5, 7).toIntOrNull() ?: return iso.take(7)
+    return "${MonthNames[m - 1]} ${iso.take(4)}"
+}
+
+private fun dayTitle(iso: String): String {
+    val m = iso.substring(5, 7).toIntOrNull() ?: return iso
+    val d = iso.substring(8, 10).toIntOrNull() ?: return iso
+    return "${MonthNames[m - 1].take(3)} $d"
+}
