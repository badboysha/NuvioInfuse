+internal fun PlayerLaunch.toExternalPlayerPlaybackRequest(): ExternalPlayerPlaybackRequest {
+    // Duration from a previous in-app playback is exact, so prefer it. On a first play in an
+    // external player (e.g. Infuse) nothing is stored yet, so fall back to the metadata runtime.
+    // Without a duration, completion (90%) is never detected and tracker scrobbles are skipped
+    // (NuvioMedia/NuvioMobile#2072).
+    val storedDurationMs = WatchProgressRepository.progressForVideo(
+        videoId = videoId ?: parentMetaId,
+        parentMetaId = parentMetaId,
+        seasonNumber = seasonNumber,
+        episodeNumber = episodeNumber,
+    )?.durationMs?.takeIf { it > 0L }
+
+    return ExternalPlayerPlaybackRequest(
         sourceUrl = sourceUrl,
         title = title,
         streamTitle = streamTitle,
         sourceHeaders = sourceHeaders,
         resumePositionMs = initialPositionMs,
-        durationMs = WatchProgressRepository.progressForVideo(
-            videoId = videoId ?: parentMetaId,
-            parentMetaId = parentMetaId,
-            seasonNumber = seasonNumber,
-            episodeNumber = episodeNumber,
-        )?.durationMs?.takeIf { it > 0L },
+        durationMs = storedDurationMs ?: metadataRuntimeMs(),
         playbackSession = externalPlaybackSession(),
         season = seasonNumber,
         episode = episodeNumber,
         episodeTitle = episodeTitle,
     )
+}
+
+/**
+ * Runtime from already-loaded metadata (no network call). Uses the episode's own runtime when
+ * the addon provides one, otherwise the title-level runtime (movie length, or a series'
+ * typical episode length).
+ */
+private fun PlayerLaunch.metadataRuntimeMs(): Long? {
+    val meta = MetaDetailsRepository.peek(parentMetaType, parentMetaId) ?: return null
+    val episodeRuntimeMinutes = meta.videos
+        .firstOrNull { video ->
+            (videoId != null && video.id == videoId) ||
+                (seasonNumber != null && episodeNumber != null &&
+                    video.season == seasonNumber && video.episode == episodeNumber)
+        }
+        ?.runtime
+        ?.takeIf { it > 0 }
+    val runtimeMinutes = episodeRuntimeMinutes
+        ?: parseRuntimeMinutes(meta.runtime)?.takeIf { it > 0 }
+        ?: return null
+    return runtimeMinutes * 60_000L
+}
