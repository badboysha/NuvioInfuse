+internal fun playerBufferedFraction(bufferedPositionMs: Long, durationMs: Long): Float =
+    if (durationMs > 0L) {
+        (bufferedPositionMs.toFloat() / durationMs.toFloat()).coerceIn(0f, 1f)
+    } else {
+        0f
+    }
