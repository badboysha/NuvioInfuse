+
+/** Fork: most subtitle addons return a dozen files per language; Infuse only needs a few to pick from. */
+internal const val INFUSE_MAX_SUBTITLES_PER_LANGUAGE = 3
+
+/** Keeps the first few distinct subtitles of each language, in the order the addon ranked them. */
+internal fun infuseSubtitles(subtitles: List<SubtitleInput>?): List<SubtitleInput> =
+    subtitles.orEmpty()
+        .distinctBy { it.url }
+        .groupBy { it.lang.lowercase() }
+        .values
+        .flatMap { it.take(INFUSE_MAX_SUBTITLES_PER_LANGUAGE) }
