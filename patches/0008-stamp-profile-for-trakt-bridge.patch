+    /**
+     * Fork (Trakt bridge on the home Pi): write this title to the active profile in Nuvio Sync
+     * right before Infuse opens, so the bridge saves Infuse's positions to the profile that
+     * pressed Play (e.g. Kids) instead of the default one. The resume point is unchanged; a new
+     * title gets a 2 s entry that the first Infuse report overwrites.
+     */
+    private fun stampProfileForTraktBridge(request: ExternalPlayerPlaybackRequest, session: InfusePlaybackSession) {
+        val playback = session.playbackSession ?: return
+        val durationMs = session.durationMs ?: return
+        runCatching {
+            WatchProgressRepository.upsertPlaybackProgress(
+                session = playback,
+                snapshot = PlayerPlaybackSnapshot(
+                    isLoading = false,
+                    isPlaying = false,
+                    isEnded = false,
+                    durationMs = durationMs,
+                    positionMs = request.resumePositionMs.coerceAtLeast(2_000L),
+                ),
+                syncRemote = true,
+            )
+        }
+    }
+
     fun restoreResult() {
         pending.value = storedSession()?.takeIf { it.returnedPositionMs != null || it.failed }
     }
