+package com.nuvio.app.features.home
+
+import android.content.Context
+import android.content.SharedPreferences
+
+internal actual object ForkHomeSettingsStorage {
+    private const val preferencesName = "nuvio_fork_home_settings"
+    private const val becauseKey = "fork_because_rows"
+
+    private var preferences: SharedPreferences? = null
+
+    fun initialize(context: Context) {
+        preferences = context.getSharedPreferences(preferencesName, Context.MODE_PRIVATE)
+    }
+
+    actual fun loadBecauseRowsEnabled(): Boolean? =
+        preferences?.takeIf { it.contains(becauseKey) }?.getBoolean(becauseKey, true)
+
+    actual fun saveBecauseRowsEnabled(enabled: Boolean) {
+        preferences?.edit()?.putBoolean(becauseKey, enabled)?.apply()
+    }
+}
