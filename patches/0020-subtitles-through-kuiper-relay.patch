+ * iOS: players like Infuse take remote subtitle URLs through their URL scheme, so nothing is
+ * downloaded here.
+ *
+ * Fork: add-on subtitle links (OpenSubtitles and the like) have no file ending, often redirect,
+ * and can be gzipped or WebVTT, and Infuse showed none of them. Each link is sent through
+ * Kuiper's `/subs/` relay instead, which serves it as a plain `.srt` file (and logs the request,
+ * so it is visible whether Infuse fetched it).
  */
 actual object SubtitleCacheProvider {
-    actual suspend fun cacheForExternalPlayer(subtitles: List<SubtitleInput>): List<SubtitleInput>? {
-        return subtitles.ifEmpty { null }
-    }
+    actual suspend fun cacheForExternalPlayer(subtitles: List<SubtitleInput>): List<SubtitleInput>? =
+        subtitles.map { it.copy(url = relaySubtitleUrl(it.url, it.lang)) }.ifEmpty { null }
+}
+
+internal const val SUBTITLE_RELAY_BASE = "https://kuiper.khanofmilton.ca/subs/"
+
+@OptIn(ExperimentalEncodingApi::class)
+internal fun relaySubtitleUrl(url: String, lang: String): String {
+    if (url.startsWith(SUBTITLE_RELAY_BASE) || !(url.startsWith("https://") || url.startsWith("http://"))) return url
+    val encoded = Base64.UrlSafe.encode(url.encodeToByteArray()).trimEnd('=')
+    val name = lang.lowercase().filter { it.isLetterOrDigit() || it == '-' }.ifEmpty { "sub" }
+    return "$SUBTITLE_RELAY_BASE$encoded/$name.srt"
 }
