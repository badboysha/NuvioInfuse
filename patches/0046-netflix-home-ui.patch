+/**
+ * Fork: per-title freshness tags from TMDB, looked up a few at a time and kept for 12 hours.
+ */
+internal object ForkCardBadges {
+    data class Entry(val primary: String?, val secondary: String?, val atMs: Long)
+
+    private const val TTL_MS = 12 * 60 * 60 * 1000L
+    private val entriesState = MutableStateFlow<Map<String, Entry>>(emptyMap())
+    val entries: StateFlow<Map<String, Entry>> = entriesState.asStateFlow()
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val limiter = Semaphore(4)
+    private val inFlightMutex = Mutex()
+    private val inFlight = mutableSetOf<String>()
+
+    private fun key(item: MetaPreview) = item.stableKey()
+
+    fun request(item: MetaPreview) {
+        val now = Clock.System.now().toEpochMilliseconds()
+        val cached = entriesState.value[key(item)]
+        if (cached != null && now - cached.atMs < TTL_MS) return
+        scope.launch {
+            val fresh = inFlightMutex.withLock { inFlight.add(key(item)) }
+            if (!fresh) return@launch
+            val result = limiter.withPermit {
+                runCatching { TmdbMetadataService.forkFreshness(item.id, item.type) }.getOrNull()
+            }
+            val at = Clock.System.now().toEpochMilliseconds()
+            entriesState.update { it + (key(item) to Entry(result?.first, result?.second, at)) }
+            inFlightMutex.withLock { inFlight.remove(key(item)) }
+        }
+    }
+}
+
+/** Fork: Netflix TOP 10 tag and New Episode / New Season / Recently Added tag over a poster. */
+@Composable
+internal fun BoxScope.ForkCardBadgeOverlay(item: MetaPreview, landscape: Boolean) {
+    val enabled by remember {
+        ForkHomeSettings.ensureLoaded()
+        ForkHomeSettings.cardBadges
+    }.collectAsStateWithLifecycle()
+    if (!enabled) return
+    val entries by ForkCardBadges.entries.collectAsStateWithLifecycle()
+    LaunchedEffect(item.stableKey()) { ForkCardBadges.request(item) }
+    val entry = entries[item.stableKey()]
+    // Cheap (ten items), and the Top 10 rows may load after the card first draws.
+    val isTop10 = ForkHomeRows.top10Rank(item.id, item.name, item.type, item.releaseInfo) != null
+
+    if (isTop10) {
+        ForkTop10Tag(Modifier.align(Alignment.TopEnd).padding(5.dp))
+    }
+    entry?.primary?.let { primary ->
+        ForkFreshPill(
+            primary = primary,
+            secondary = entry.secondary,
+            modifier = if (landscape) {
+                Modifier.align(Alignment.TopStart).padding(6.dp)
+            } else {
+                Modifier.align(Alignment.BottomCenter).padding(bottom = 6.dp)
+            },
+        )
+    }
+}
+
+@Composable
+internal fun ForkTop10Tag(modifier: Modifier = Modifier) {
+    Column(
+        modifier = modifier
+            .clip(RoundedCornerShape(2.dp))
+            .background(ForkNetflixHome.NetflixRed)
+            .padding(horizontal = 4.dp, vertical = 2.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text("TOP", color = Color.White, fontSize = 6.sp, lineHeight = 7.sp, fontWeight = FontWeight.Black)
+        Text("10", color = Color.White, fontSize = 11.sp, lineHeight = 11.sp, fontWeight = FontWeight.Black)
+    }
+}
+
+@Composable
+internal fun ForkFreshPill(primary: String, secondary: String?, modifier: Modifier = Modifier) {
+    Row(modifier = modifier.clip(RoundedCornerShape(2.dp))) {
+        Text(
+            text = primary,
+            color = Color.White,
+            fontSize = 9.sp,
+            lineHeight = 11.sp,
+            fontWeight = FontWeight.Bold,
+            maxLines = 1,
+            modifier = Modifier.background(ForkNetflixHome.NetflixRed).padding(horizontal = 5.dp, vertical = 2.dp),
+        )
+        if (secondary != null) {
+            Text(
+                text = secondary,
+                color = Color.Black,
+                fontSize = 9.sp,
+                lineHeight = 11.sp,
+                fontWeight = FontWeight.Bold,
+                maxLines = 1,
+                modifier = Modifier.background(Color.White).padding(horizontal = 5.dp, vertical = 2.dp),
+            )
+        }
+    }
+}
+
+/** Fork: Netflix's round play button over a Continue Watching card. */
+@Composable
+internal fun ForkPlayCircle(size: Dp, modifier: Modifier = Modifier) {
+    Box(
+        modifier = modifier
+            .size(size)
+            .clip(CircleShape)
+            .background(Color.Black.copy(alpha = 0.35f))
+            .border(2.dp, Color.White, CircleShape),
+        contentAlignment = Alignment.Center,
+    ) {
+        Icon(
+            imageVector = Icons.Rounded.PlayArrow,
+            contentDescription = null,
+            tint = Color.White,
+            modifier = Modifier.size(size * 0.6f),
+        )
+    }
+}
