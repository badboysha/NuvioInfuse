+                "S${item.seasonNumber}:E${item.episodeNumber}"
+            } else {
+                null
+            }
+            if (label != null) {
+                Text(
+                    text = label,
+                    color = Color.White,
+                    style = MaterialTheme.typography.labelLarge.copy(fontWeight = FontWeight.Bold),
+                    modifier = Modifier
+                        .align(Alignment.BottomCenter)
+                        .padding(bottom = 8.dp),
+                )
+            }
+            if (item.progressFraction > 0f) {
+                Box(
+                    modifier = Modifier
+                        .align(Alignment.BottomStart)
+                        .fillMaxWidth()
+                        .height(3.dp)
+                        .background(Color.White.copy(alpha = 0.3f)),
+                ) {
+                    Box(
+                        modifier = Modifier
+                            .fillMaxHeight()
+                            .fillMaxWidth(item.progressFraction.coerceIn(0f, 1f))
+                            .background(com.nuvio.app.features.home.ForkNetflixHome.NetflixRed),
+                    )
+                }
+            }
+        }
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(34.dp)
+                .padding(horizontal = 6.dp),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Icon(
+                imageVector = androidx.compose.material.icons.Icons.Outlined.Info,
+                contentDescription = "Details",
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier
+                    .size(28.dp)
+                    .clip(CircleShape)
+                    .clickable {
+                        val open = com.nuvio.app.features.home.ForkNetflixHome.onCwInfo
+                        if (open != null) open(com.nuvio.app.features.home.ForkNetflixHome.infoPreview(item))
+                        else onLongClick?.invoke()
+                    }
+                    .padding(4.dp),
+            )
+            Icon(
+                imageVector = androidx.compose.material.icons.Icons.Rounded.MoreVert,
+                contentDescription = "More",
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier
+                    .size(28.dp)
+                    .clip(CircleShape)
+                    .clickable { onLongClick?.invoke() }
+                    .padding(4.dp),
+            )
+        }
+    }
