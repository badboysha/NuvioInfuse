+/** Fork: Netflix home touches shared by Home, the hero and Continue Watching. */
+internal object ForkNetflixHome {
+    val NetflixRed = Color(0xFFE50914)
+
+    /** Home's poster tap, so a Continue Watching card's ⓘ can open the details page. */
+    var onCwInfo: ((MetaPreview) -> Unit)? = null
+
+    fun infoPreview(item: ContinueWatchingItem) = MetaPreview(
+        id = item.parentMetaId,
+        type = item.parentMetaType,
+        name = item.title,
+        poster = item.poster,
+        banner = item.background,
+        logo = item.logo,
+    )
+}
+
+/** Fork: Netflix's Shows / Movies switch. */
+internal enum class ForkHomeTypeFilter(val label: String) {
+    All("Home"), Shows("Shows"), Movies("Movies");
+
+    fun matchesType(type: String): Boolean = when (this) {
+        All -> true
+        Shows -> type.equals("series", true) || type.equals("tv", true) || type.equals("show", true)
+        Movies -> type.equals("movie", true)
+    }
+}
+
+internal fun List<HomeCatalogSection>.forkType(filter: ForkHomeTypeFilter): List<HomeCatalogSection> =
+    if (filter == ForkHomeTypeFilter.All) this
+    else mapNotNull { section ->
+        val items = section.items.filter { filter.matchesType(it.type) }
+        if (items.isEmpty()) null else section.copy(items = items, availableItemCount = items.size)
+    }
+
+@Composable
+internal fun ForkHomeTypeChips(
+    selection: ForkHomeTypeFilter,
+    onSelect: (ForkHomeTypeFilter) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        ForkHomeTypeFilter.entries.forEach { filter ->
+            val selected = filter == selection
+            Text(
+                text = filter.label,
+                style = MaterialTheme.typography.labelLarge.copy(fontSize = 14.sp),
+                fontWeight = if (selected) FontWeight.Bold else FontWeight.Medium,
+                color = if (selected) Color.Black else MaterialTheme.colorScheme.onBackground,
+                modifier = Modifier
+                    .clip(RoundedCornerShape(50))
+                    .then(
+                        if (selected) Modifier.background(Color.White)
+                        else Modifier.border(1.dp, MaterialTheme.colorScheme.onBackground.copy(alpha = 0.45f), RoundedCornerShape(50))
+                    )
+                    .clickable { onSelect(filter) }
+                    .padding(horizontal = 16.dp, vertical = 7.dp),
+            )
+        }
+    }
+}
