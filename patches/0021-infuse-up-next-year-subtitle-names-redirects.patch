+import com.nuvio.app.features.player.skip.NextEpisodeCard
+import com.nuvio.app.features.player.skip.NextEpisodeInfo
+import com.nuvio.app.features.player.skip.PlayerNextEpisodeRules
+import com.nuvio.app.features.watchprogress.WatchProgressPlaybackSession
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Fork: Up Next for episodes played in an external player (Infuse).
+ *
+ * Infuse plays one file and hands back to Nuvio when it stops. When that happens near the end of an
+ * episode (finished, past 90%, or inside the last two minutes / the Next Episode threshold), Nuvio
+ * shows its Next Episode card with a 10-second countdown; it then plays the next episode the same
+ * way the Play button would, so auto-play and Reuse Last Link pick the source and it opens in Infuse.
+ */
+internal object ExternalUpNext {
+    data class Pending(
+        val session: WatchProgressPlaybackSession,
+        val next: NextEpisodeInfo,
+    )
+
+    private val pendingState = MutableStateFlow<Pending?>(null)
+    val pending = pendingState.asStateFlow()
+
+    suspend fun onExternalPlaybackReturned(result: ExternalPlaybackResult, fallbackSession: WatchProgressPlaybackSession?) {
+        val session = result.playbackSession ?: fallbackSession ?: return
+        val season = session.seasonNumber ?: return
+        val episode = session.episodeNumber ?: return
+        if (session.parentMetaType == "movie") return
+        if (!reachedEnd(result)) return
+        val meta = MetaDetailsRepository.peek(session.parentMetaType, session.parentMetaId)
+            ?.takeIf { it.videos.isNotEmpty() }
+            ?: runCatching { MetaDetailsRepository.fetch(session.parentMetaType, session.parentMetaId) }.getOrNull()
+            ?: return
+        val video = PlayerNextEpisodeRules.resolveNextEpisode(meta.videos, season, episode) ?: return
+        val aired = PlayerNextEpisodeRules.hasEpisodeAired(video.released)
+        pendingState.value = Pending(
+            session = session,
+            next = NextEpisodeInfo(
+                videoId = video.id,
+                season = video.season ?: return,
+                episode = video.episode ?: return,
+                title = video.title,
+                thumbnail = video.thumbnail,
+                overview = video.overview,
+                released = video.released,
+                hasAired = aired,
+                isWatched = false,
+                unairedMessage = if (aired) null else "Airs ${video.released ?: "TBA"}",
+            ),
+        )
+    }
+
+    internal fun reachedEnd(result: ExternalPlaybackResult): Boolean {
+        if (!result.endedByUser) return true
+        val durationMs = result.durationMs?.takeIf { it > 0L } ?: return false
+        PlayerSettingsRepository.ensureLoaded()
+        val minutes = PlayerSettingsRepository.uiState.value.nextEpisodeThresholdMinutesBeforeEnd
+        val windowMs = maxOf(2 * 60_000L, (minutes * 60_000f).toLong())
+        return result.positionMs >= durationMs * 9 / 10 || durationMs - result.positionMs <= windowMs
+    }
+
+    fun dismiss() {
+        pendingState.value = null
+    }
+}
+
+private const val UP_NEXT_COUNTDOWN_SEC = 10
+
+/** Shows the card over the whole app; place it inside the root Box. */
+@Composable
+internal fun ExternalUpNextOverlay(
+    onPlayNext: (WatchProgressPlaybackSession, NextEpisodeInfo) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val pending by ExternalUpNext.pending.collectAsStateWithLifecycle()
+    val currentOnPlayNext by rememberUpdatedState(onPlayNext)
+    var countdown by remember { mutableStateOf<Int?>(null) }
+
+    LaunchedEffect(pending) {
+        val current = pending ?: run {
+            countdown = null
+            return@LaunchedEffect
+        }
+        if (!current.next.hasAired) {
+            countdown = null
+            return@LaunchedEffect
+        }
+        for (remaining in UP_NEXT_COUNTDOWN_SEC downTo 1) {
+            countdown = remaining
+            delay(1_000L)
+        }
+        countdown = null
+        ExternalUpNext.dismiss()
+        currentOnPlayNext(current.session, current.next)
+    }
+
+    val current = pending
+    NextEpisodeCard(
+        nextEpisode = current?.next,
+        visible = current != null,
+        isAutoPlaySearching = false,
+        autoPlaySourceName = if (countdown != null) "Infuse" else null,
+        autoPlayCountdownSec = countdown,
+        blurred = false,
+        onPlayNext = {
+            val target = ExternalUpNext.pending.value ?: return@NextEpisodeCard
+            ExternalUpNext.dismiss()
+            if (target.next.hasAired) currentOnPlayNext(target.session, target.next)
+        },
+        onDismiss = ExternalUpNext::dismiss,
+        modifier = modifier
+            .windowInsetsPadding(WindowInsets.safeDrawing)
+            .padding(end = 16.dp, bottom = 88.dp),
+    )
+}
