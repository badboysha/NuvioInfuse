+
+/**
+ * Fork: follows a stream link's HTTP redirects (debrid / Kuiper `/resolve/` 302s) and returns where
+ * it ends up, or [url] unchanged when it does not redirect or anything goes wrong. Infuse handed a
+ * redirecting link can stall or fail with "Server didn't report the size of the file".
+ */
+internal expect suspend fun resolveExternalStreamUrl(url: String): String
