+package com.nuvio.app.features.home.components
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.height
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.em
+import androidx.compose.ui.unit.sp
+
+/** Fork: Netflix-style Top 10 rows — a big outlined rank numeral behind each of the first ten cards. */
+internal object Top10Rank {
+    fun isTop10(title: String): Boolean {
+        val t = title.lowercase()
+        return t.contains("top 10") || t.contains("top ten") || t.contains("top10")
+    }
+
+    fun ranks(title: String, keys: List<String>): Map<String, Int> {
+        if (!isTop10(title)) return emptyMap()
+        val out = LinkedHashMap<String, Int>()
+        keys.take(10).forEachIndexed { i, k -> out.putIfAbsent(k, i + 1) }
+        return out
+    }
+}
+
+@Composable
+internal fun Top10RankedCard(
+    rank: Int?,
+    artworkHeight: Dp,
+    card: @Composable () -> Unit,
+) {
+    if (rank == null) {
+        card()
+        return
+    }
+    val size = (artworkHeight.value * 0.9f).sp
+    Row(
+        verticalAlignment = Alignment.Top,
+        horizontalArrangement = Arrangement.spacedBy(-(artworkHeight * 0.16f)),
+    ) {
+        Box(Modifier.height(artworkHeight), contentAlignment = Alignment.BottomCenter) {
+            val base = TextStyle(
+                fontSize = size,
+                fontWeight = FontWeight.Black,
+                lineHeight = size,
+                letterSpacing = if (rank == 10) (-0.08).em else 0.em,
+            )
+            Text("$rank", style = base.copy(color = Color.Black))
+            Text("$rank", style = base.copy(color = Color.White.copy(alpha = 0.85f), drawStyle = Stroke(width = 6f)))
+        }
+        card()
+    }
+}
