+/** Fork: "Good morning / afternoon / evening" in the device's time zone. */
+private fun forkGreeting(): String {
+    val hour = kotlin.time.Clock.System.now()
+        .toLocalDateTime(kotlinx.datetime.TimeZone.currentSystemDefault()).hour
+    return when (hour) {
+        in 5..11 -> "Good morning"
+        in 12..16 -> "Good afternoon"
+        else -> "Good evening"
     }
