+package com.nuvio.app.features.player
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class SubtitleSyncRelayTest {
+    @Test
+    fun relayLinkGainsTheVideoSegmentOnce() {
+        val relayed = "${KUIPER_SUBS_RELAY}c3Vi/English%201.en.srt"
+        val withVideo = relayUrlWithVideo(relayed, "https://k.example/resolve/tb/abc?x=1")
+        assertEquals("${KUIPER_SUBS_RELAY}c3Vi/v/aHR0cHM6Ly9rLmV4YW1wbGUvcmVzb2x2ZS90Yi9hYmM_eD0x/English%201.en.srt", withVideo)
+        assertEquals(withVideo, relayUrlWithVideo(withVideo, "https://other.example/v.mkv"))
+    }
+
+    @Test
+    fun otherLinksAreLeftAlone() {
+        assertEquals("https://subs.example/1", relayUrlWithVideo("https://subs.example/1", "https://k.example/v"))
+        assertEquals("${KUIPER_SUBS_RELAY}c3Vi/en.srt", relayUrlWithVideo("${KUIPER_SUBS_RELAY}c3Vi/en.srt", "file:///v.mkv"))
+    }
+}
