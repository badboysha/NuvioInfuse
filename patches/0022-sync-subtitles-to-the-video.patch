@@ -0,0 +1,42 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.addons.httpRequestRaw
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+import kotlinx.coroutines.withTimeoutOrNull
+
+/**
+ * Fork: subtitles lined up with the video before Infuse plays it.
+ *
+ * Add-on subtitles are often timed for a different release of the episode (all five English
+ * OpenSubtitles files for one Strange New Worlds episode were 0.8-1.2 s early and drifting). The
+ * Kuiper relay can sync a subtitle against the video's audio when its link also names the video
+ * (`/subs/<subtitle>/v/<video>/<name>.srt`). Before Infuse opens, Nuvio asks the relay for the
+ * subtitle once and waits up to [SYNC_WARM_UP_SECONDS] for the synced copy, so Infuse's own fetch
+ * gets it from the relay's cache; if it is not ready in time Infuse gets the original and the
+ * synced copy is used from the next time the episode is opened.
+ */
+internal const val KUIPER_SUBS_RELAY = "https://kuiper.khanofmilton.ca/subs/"
+internal const val SYNC_WARM_UP_SECONDS = 35
+
+@OptIn(ExperimentalEncodingApi::class)
+internal fun relayUrlWithVideo(subtitleUrl: String, videoUrl: String): String {
+    if (!subtitleUrl.startsWith(KUIPER_SUBS_RELAY)) return subtitleUrl
+    if (!videoUrl.startsWith("http://") && !videoUrl.startsWith("https://")) return subtitleUrl
+    val rest = subtitleUrl.removePrefix(KUIPER_SUBS_RELAY)
+    val subtitlePart = rest.substringBefore('/')
+    val name = rest.substringAfterLast('/')
+    if (rest.contains("/v/") || subtitlePart.isEmpty() || name.isEmpty()) return subtitleUrl
+    val video = Base64.UrlSafe.encode(videoUrl.encodeToByteArray()).trimEnd('=')
+    return "$KUIPER_SUBS_RELAY$subtitlePart/v/$video/$name"
+}
+
+/** Asks the relay for the synced subtitle so it is cached before Infuse fetches it. */
+internal suspend fun warmUpSubtitleSync(relayUrl: String) {
+    if (!relayUrl.startsWith(KUIPER_SUBS_RELAY) || !relayUrl.contains("/v/")) return
+    withTimeoutOrNull((SYNC_WARM_UP_SECONDS + 5) * 1_000L) {
+        runCatching {
+            httpRequestRaw(method = "GET", url = "$relayUrl?wait=$SYNC_WARM_UP_SECONDS", headers = emptyMap(), body = "")
+        }
+    }
+}
