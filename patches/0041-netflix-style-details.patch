+/** Fork: Netflix red, used for the Top 10 badge. */
+private val ForkNetflixRed = Color(0xFFE50914)
+
+/**
+ * Fork: Netflix-style "TOP 10 · #3 in TV Shows Today" line under the title on the details page,
+ * when the title is in one of the Top 10 rows Home last loaded. Nothing otherwise.
+ */
+@Composable
+internal fun ForkTop10Badge(meta: MetaDetails, modifier: Modifier = Modifier) {
+    val trendingEnabled by remember {
+        ForkHomeSettings.ensureLoaded()
+        ForkHomeSettings.trendingRowsEnabled
+    }.collectAsStateWithLifecycle()
+    if (!trendingEnabled) return
+    val rank = remember(meta.id, meta.name, meta.type, meta.releaseInfo) {
+        ForkHomeRows.top10Rank(meta.id, meta.name, meta.type, meta.releaseInfo)
+    } ?: return
+    Row(
+        modifier = modifier,
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        Box(
+            modifier = Modifier
+                .size(24.dp)
+                .background(ForkNetflixRed, RoundedCornerShape(3.dp)),
+            contentAlignment = Alignment.Center,
+        ) {
+            Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                Text("TOP", color = Color.White, fontSize = 6.sp, lineHeight = 6.sp, fontWeight = FontWeight.Bold)
+                Text("10", color = Color.White, fontSize = 11.sp, lineHeight = 11.sp, fontWeight = FontWeight.Black)
+            }
+        }
+        Text(
+            text = "#${rank.first} in ${rank.second} Today",
+            style = MaterialTheme.typography.titleSmall,
+            fontWeight = FontWeight.Bold,
+            color = Color.White,
+        )
+    }
+}
+
+/** Fork: whether the details Play button is Netflix white (Settings → Meta screen). */
+@Composable
+internal fun forkWhitePlayButton(): Boolean {
+    val white by remember {
+        ForkHomeSettings.ensureLoaded()
+        ForkHomeSettings.whitePlayButton
+    }.collectAsStateWithLifecycle()
+    return white
+}
