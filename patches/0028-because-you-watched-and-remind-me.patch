+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt
@@ -0,0 +1,87 @@
+package com.nuvio.app.features.home
+
+import com.nuvio.app.features.catalog.CatalogTarget
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import com.nuvio.app.features.watched.WatchedRepository
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * Fork: extra Netflix-style Home rows built from TMDB, plus the "Remind Me" date check.
+ *  - "Because you watched X": recommendations for the most recently finished titles.
+ * Rows come back as ordinary [HomeCatalogSection]s with no "See All" (nothing behind them).
+ */
+object ForkHomeRows {
+    const val BECAUSE_KEY_PREFIX = "fork.because."
+
+    private val mutex = Mutex()
+    private var becauseSignature: String? = null
+    private var becauseRows: List<HomeCatalogSection> = emptyList()
+
+    suspend fun becauseYouWatched(maxRows: Int = 2): List<HomeCatalogSection> {
+        val watched = WatchedRepository.uiState.value.items
+        val seeds = watched
+            .filter { it.type == "movie" || it.type == "series" }
+            .sortedByDescending { it.markedAtEpochMs }
+            .distinctBy { it.id }
+            .take(maxRows)
+        if (seeds.isEmpty()) return emptyList()
+        val signature = seeds.joinToString("|") { it.id }
+        mutex.withLock { if (signature == becauseSignature) return becauseRows }
+
+        val seenIds = watched.map { it.id }.toSet()
+        val seenNames = watched.map { it.name.trim().lowercase() }.toSet()
+        val usedIds = mutableSetOf<String>()
+        val rows = seeds.mapNotNull { seed ->
+            val items = TmdbMetadataService.recommendationsFor(seed.id, seed.type)
+                .filter { it.id !in seenIds && it.name.trim().lowercase() !in seenNames && usedIds.add(it.id) }
+            if (items.size < 4) return@mapNotNull null
+            section(
+                key = BECAUSE_KEY_PREFIX + seed.id,
+                title = "Because you watched ${seed.name}",
+                type = seed.type,
+                items = items,
+            )
+        }
+        mutex.withLock {
+            becauseSignature = signature
+            becauseRows = rows
+        }
+        return rows
+    }
+
+    @Throws(Throwable::class)
+    suspend fun becauseYouWatchedChecked(maxRows: Int): List<HomeCatalogSection> = becauseYouWatched(maxRows)
+
+    /** True when the title's release date (yyyy-MM-dd) is after today. */
+    fun isUnreleased(rawReleaseDate: String?, nowEpochMs: Long): Boolean {
+        val date = rawReleaseDate?.takeIf { it.length >= 10 }?.substring(0, 10) ?: return false
+        return date > isoDate(nowEpochMs)
+    }
+
+    private fun section(key: String, title: String, type: String, items: List<MetaPreview>) = HomeCatalogSection(
+        key = key,
+        title = title,
+        subtitle = "",
+        addonName = "TMDB",
+        target = CatalogTarget.Addon(manifestUrl = "", contentType = type, catalogId = key),
+        items = items,
+        availableItemCount = items.size,
+        hasMore = false,
+    )
+
+    /** UTC yyyy-MM-dd for an epoch time (civil-from-days, no datetime library needed). */
+    fun isoDate(epochMs: Long): String {
+        val days = epochMs.floorDiv(86_400_000L)
+        val z = days + 719_468
+        val era = z.floorDiv(146_097L)
+        val doe = z - era * 146_097
+        val yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
+        val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
+        val mp = (5 * doy + 2) / 153
+        val d = doy - (153 * mp + 2) / 5 + 1
+        val m = if (mp < 10) mp + 3 else mp - 9
+        val y = yoe + era * 400 + if (m <= 2) 1 else 0
+        return "${y.toString().padStart(4, '0')}-${m.toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}"
+    }
+}
