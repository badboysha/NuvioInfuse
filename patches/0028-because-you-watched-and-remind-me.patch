+    private fun movieReminderRequests(items: List<LibraryItem>): List<EpisodeReleaseNotificationRequest> {
+        val today = CurrentDateProvider.todayIsoDate()
+        val isoDate = Regex("""^\d{4}-\d{2}-\d{2}""")
+        return items
+            .filter { item -> !isSeriesLibraryType(item.type) }
+            .mapNotNull { item ->
+                val date = item.releaseInfo?.trim()?.takeIf { isoDate.containsMatchIn(it) }?.take(10)
+                    ?: return@mapNotNull null
+                if (date <= today) return@mapNotNull null
+                EpisodeReleaseNotificationRequest(
+                    requestId = "movie-release-${ProfileRepository.activeProfileId}-${item.id}",
+                    notificationTitle = item.name,
+                    notificationBody = "Out today. Tap to watch.",
+                    releaseDateIso = date,
+                    deepLinkUrl = buildMetaDeepLinkUrl(type = item.type, id = item.id),
+                    backdropUrl = item.banner ?: item.poster,
+                )
+            }
+    }
