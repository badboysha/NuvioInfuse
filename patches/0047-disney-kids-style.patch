+// MARK: Fork: Disney+ look for a Kids profile
+
+/** Navy theme and kids studio tiles (Disney, Pixar, DreamWorks, Illumination, Nickelodeon, Cartoon Network). */
+internal object ForkDisneyKids {
+    val Navy = Color(0xFF111833)
+    val NavySurface = Color(0xFF1A2244)
+    val NavySurfaceVariant = Color(0xFF232C52)
+    val Sky = Color(0xFF3FA0F5)
+
+    data class Brand(val tmdbId: Int, val name: String, val isNetwork: Boolean) {
+        val key get() = (if (isNetwork) "network-" else "company-") + tmdbId
+    }
+
+    val brands = listOf(
+        Brand(2, "Disney", false),
+        Brand(3, "Pixar", false),
+        Brand(521, "DreamWorks", false),
+        Brand(6704, "Illumination", false),
+        Brand(13, "Nickelodeon", true),
+        Brand(56, "Cartoon Network", true),
+    )
+
+    /** Set by the app root: opens the studio's titles (kind is "company" or "network"). */
+    var onOpenBrand: ((kind: String, tmdbId: Int, name: String) -> Unit)? = null
+
+    private val logosState = MutableStateFlow<Map<String, String>>(emptyMap())
+    val logos: StateFlow<Map<String, String>> = logosState.asStateFlow()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private var loading = false
+
+    fun loadLogosIfNeeded() {
+        if (loading || logosState.value.size == brands.size) return
+        loading = true
+        scope.launch {
+            brands.forEach { brand ->
+                if (brand.key in logosState.value) return@forEach
+                val url = runCatching { TmdbMetadataService.forkBrandLogo(brand.tmdbId, brand.isNetwork) }.getOrNull()
+                if (url != null) logosState.update { it + (brand.key to url) }
+            }
+            loading = false
+        }
+    }
+}
+
+@Composable
+internal fun ForkKidsBrandRow(horizontalPadding: Dp, modifier: Modifier = Modifier) {
+    val logos by ForkDisneyKids.logos.collectAsStateWithLifecycle()
+    LaunchedEffect(Unit) { ForkDisneyKids.loadLogosIfNeeded() }
+    androidx.compose.foundation.lazy.LazyRow(
+        modifier = modifier.fillMaxWidth().padding(vertical = 10.dp),
+        contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = horizontalPadding),
+        horizontalArrangement = Arrangement.spacedBy(10.dp),
+    ) {
+        items(ForkDisneyKids.brands.size) { index ->
+            val brand = ForkDisneyKids.brands[index]
+            ForkKidsBrandTile(brand = brand, logoUrl = logos[brand.key])
+        }
+    }
+}
+
+@Composable
+private fun ForkKidsBrandTile(brand: ForkDisneyKids.Brand, logoUrl: String?) {
+    val shape = RoundedCornerShape(10.dp)
+    Box(
+        modifier = Modifier
+            .size(width = 128.dp, height = 72.dp)
+            .clip(shape)
+            .background(
+                androidx.compose.ui.graphics.Brush.verticalGradient(
+                    listOf(Color(0xFF30395F), Color(0xFF1A213D)),
+                ),
+            )
+            .border(1.dp, Color.White.copy(alpha = 0.18f), shape)
+            .clickable {
+                ForkDisneyKids.onOpenBrand?.invoke(
+                    if (brand.isNetwork) "network" else "company",
+                    brand.tmdbId,
+                    brand.name,
+                )
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        if (logoUrl != null) {
+            coil3.compose.AsyncImage(
+                model = logoUrl,
+                contentDescription = brand.name,
+                colorFilter = androidx.compose.ui.graphics.ColorFilter.tint(
+                    Color.White,
+                    androidx.compose.ui.graphics.BlendMode.SrcIn,
+                ),
+                contentScale = androidx.compose.ui.layout.ContentScale.Fit,
+                modifier = Modifier.padding(horizontal = 18.dp, vertical = 16.dp),
+            )
+        } else {
+            Text(
+                text = brand.name,
+                color = Color.White,
+                fontWeight = FontWeight.Bold,
+                fontSize = 13.sp,
+                maxLines = 2,
+                textAlign = androidx.compose.ui.text.style.TextAlign.Center,
+                modifier = Modifier.padding(horizontal = 8.dp),
+            )
+        }
+    }
+}
